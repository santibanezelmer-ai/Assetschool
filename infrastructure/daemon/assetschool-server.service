[Unit]
Description=AssetSchool Server — Servidor Escolar Independiente (LAN-First)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=assetschool
Group=assetschool
WorkingDirectory=/opt/assetschool/server
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/assetschool/server.log
StandardError=append:/var/log/assetschool/server-error.log
LimitNOFILE=65536
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATABASE_HOST=127.0.0.1
Environment=DATABASE_PORT=5432
Environment=SERVER_MODE=dedicated

# Sandboxing and security
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
