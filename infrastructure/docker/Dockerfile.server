FROM node:24-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages ./packages
COPY apps/local-server ./apps/local-server

RUN npm ci --include=dev
RUN npm run build --workspace=@assetschool/shared-types
RUN npm run build --workspace=@assetschool/protocol
RUN npm run build --workspace=@assetschool/permissions
RUN npm run build --workspace=@assetschool/validators
RUN npm run build --workspace=apps/local-server

FROM node:24-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/local-server/dist ./apps/local-server/dist
COPY --from=builder /app/apps/local-server/package.json ./apps/local-server/package.json
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000
EXPOSE 48500/udp
EXPOSE 48501

CMD ["node", "apps/local-server/dist/main.js"]
