<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.assetschool.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/AssetSchool Student.app/Contents/MacOS/AssetSchoolAgent</string>
        <string>--daemon-mode</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Library/Application Support/AssetSchool/logs/daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/AssetSchool/logs/daemon.stderr.log</string>
</dict>
</plist>
