{
  "name": "assetschool-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AssetSchool — Plataforma Profesional de Gestión, Supervisión y Control de Aulas Informáticas (LAN-first)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "server:start": "npm run start --workspace=apps/local-server",
    "server:dev": "npm run start:dev --workspace=apps/local-server",
    "web:dev": "npm run dev --workspace=apps/teacher-web",
    "web:build": "npm run build --workspace=apps/teacher-web",
    "env:dev": "node scripts/generate-dev-env.mjs",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "devDependencies": {
    "embedded-postgres": "16.15.0-beta.19",
    "typescript": "^5.7.2"
  }
}
