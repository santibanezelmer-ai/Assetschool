{
  "name": "@assetschool/local-server",
  "version": "1.0.0",
  "description": "AssetSchool Core Central Server (NestJS, REST API, Socket.IO, PostgreSQL)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build || tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "jest",
    "test:pg": "jest --runInBand --testPathIgnorePatterns=/node_modules/ --testRegex=\".*\\.pg-integration\\.spec\\.ts$\" --globalSetup=\"<rootDir>/../test/pg-global-setup.mjs\" --globalTeardown=\"<rootDir>/../test/pg-global-teardown.mjs\" --testTimeout=120000",
    "test:cov": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@assetschool/permissions": "*",
    "@assetschool/protocol": "*",
    "@assetschool/shared-types": "*",
    "@assetschool/validators": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "bcrypt": "^5.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pg-mem": "^3.0.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.pg-integration\\.spec\\.ts$"
    ],
    "setupFiles": [
      "<rootDir>/../test/jest.setup-env.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@assetschool/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts",
      "^@assetschool/protocol$": "<rootDir>/../../../packages/protocol/src/index.ts",
      "^@assetschool/permissions$": "<rootDir>/../../../packages/permissions/src/index.ts",
      "^@assetschool/validators$": "<rootDir>/../../../packages/validators/src/index.ts",
      "^@assetschool/ui-components$": "<rootDir>/../../../packages/ui-components/src/index.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
