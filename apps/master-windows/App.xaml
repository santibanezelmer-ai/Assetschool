<Application x:Class="AssetSchool.Master.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBackground" Color="#0F172A" />
        <SolidColorBrush x:Key="SecondaryBackground" Color="#1E293B" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#334155" />
        <SolidColorBrush x:Key="AccentColor" Color="#38BDF8" />
        <SolidColorBrush x:Key="TextColor" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SecondaryText" Color="#94A3B8" />
    </Application.Resources>
</Application>
