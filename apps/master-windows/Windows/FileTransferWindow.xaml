<Window x:Class="AssetSchool.Master.Windows.FileTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Transferencia y Recolección de Archivos — AssetSchool" Height="620" Width="960"
        Background="#0F172A" WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Dual-Pane Explorer -->
            <RowDefinition Height="Auto" /> <!-- Action Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Status / Progress Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="📁 DISTRIBUCIÓN Y RECOLECCIÓN DE TRABAJOS" Foreground="White" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Transferencia segura basada en SHA-256 y sandbox escolar" Foreground="#94A3B8" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Destino:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbTargetScope" Width="200" Height="28" Background="#1E293B" Foreground="White" BorderBrush="#334155" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- DUAL-PANE EXPLORER -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />     <!-- Left Pane: Local Teacher Files -->
                <ColumnDefinition Width="12" />    <!-- Divider -->
                <ColumnDefinition Width="*" />     <!-- Right Pane: Student Sandbox Files -->
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: LOCAL FILES -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="💻 Archivos del Profesor (Local)" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Click="OnSelectLocalFolderClicked" Content="Examinar..." Background="#334155" Foreground="White" BorderThickness="0" Padding="8,3" DockPanel.Dock="Right" FontSize="11" />
                    </DockPanel>

                    <ListBox x:Name="LstLocalFiles" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" Foreground="White" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Padding="4">
                                    <TextBlock Text="📄" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="#94A3B8" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT PANE: REMOTE STUDENT SANDBOX -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="🎓 Sandbox Estudiante (Downloads\AssetSchool)" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Click="OnRefreshRemoteListClicked" Content="🔄 Actualizar" Background="#334155" Foreground="White" BorderThickness="0" Padding="8,3" DockPanel.Dock="Right" FontSize="11" />
                    </DockPanel>

                    <ListBox x:Name="LstRemoteFiles" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" Foreground="White" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Padding="4">
                                    <TextBlock Text="📄" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="#94A3B8" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ACTION TOOLBAR -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Click="OnSendFileClicked" Content="📤 Distribuir Archivo" Background="#0284C7" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="14,6" Margin="0,0,8,0" />
                    <Button Click="OnCollectFileClicked" Content="📥 Recoger Archivo Seleccionado" Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="14,6" Margin="0,0,8,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSha256Status" Text="Integridad SHA-256 Verificada ✓" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- STATUS / PROGRESS BAR -->
        <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,4,0,0">
            <DockPanel>
                <ProgressBar x:Name="TransferProgressBar" Height="4" Background="#1E293B" Foreground="#0284C7" DockPanel.Dock="Top" Margin="0,0,0,6" Value="0" />
                <TextBlock x:Name="TxtTransferLog" Text="Listo para transferir archivos al aula." Foreground="#94A3B8" FontSize="11" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
